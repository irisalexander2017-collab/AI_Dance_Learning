    "typescript": "6.0.3",
    "vite": "8.1.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "tsx": "4.23.15"
